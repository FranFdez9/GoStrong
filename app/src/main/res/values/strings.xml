    <!-- Catálogo Rutinas -->
    <string name="cat_rut_1_nombre">Fullbody Principiante</string>
    <string name="cat_rut_1_desc">Rutina fullbody 3 días a la semana. Perfecta para empezar en el gimnasio.</string>
    <string name="cat_rut_2_nombre">Push Pull 4 Días</string>
    <string name="cat_rut_2_desc">Rutina Push/Pull de 4 días. Empuje (pecho, hombros, tríceps) y tirón (espalda, bíceps).</string>
    <string name="cat_rut_3_nombre">Sesión Pierna Completa</string>
    <string name="cat_rut_3_desc">Sesión de pierna intensa: cuádriceps, isquios y gemelos.</string>
    <string name="cat_rut_4_nombre">Boxeo Principiante 3 Días</string>
    <string name="cat_rut_4_desc">Introducción al boxeo: técnica, acondicionamiento y golpeo básico.</string>
    <string name="cat_rut_5_nombre">MMA Intermedio 4 Días</string>
    <string name="cat_rut_5_desc">Rutina MMA completa: striking, grappling, fuerza y acondicionamiento.</string>
    <string name="cat_rut_6_nombre">Sesión Boxeo Intensa</string>
    <string name="cat_rut_6_desc">Sesión de boxeo completa de ~60 minutos. Técnica + saco + acondicionamiento.</string>
    <string name="cat_rut_7_nombre">Running Principiante C25K</string>
    <string name="cat_rut_7_desc">Programa de 3 días para pasar de caminar a correr 5km. Basado en el método C25K.</string>
    <string name="cat_rut_8_nombre">HIIT + Cardio 4 Días</string>
    <string name="cat_rut_8_desc">Combina sesiones HIIT explosivas con cardio de baja intensidad para quemar grasa.</string>
    <string name="cat_rut_9_nombre">HIIT Express 20 Minutos</string>
    <string name="cat_rut_9_desc">Sesión de alta intensidad en solo 20 minutos. Sin material, máxima quema calórica.</string>
    <string name="cat_rut_10_nombre">Fuerza Powerlifting 5x5</string>
    <string name="cat_rut_10_desc">El método 5x5 para ganar pura fuerza levantando las máximas cargas en movimientos básicos.</string>
    <string name="cat_rut_11_nombre">Dominio Corporal Calistenia</string>
    <string name="cat_rut_11_desc">Entrenamiento usando exclusivamente tu peso corporal (parque de barras o casa).</string>

    <!-- Catálogo Dietas -->
    <string name="cat_diet_1_nombre">Plan Déficit Calórico</string>
    <string name="cat_diet_1_desc">Plan semanal con déficit moderado de 400-500 kcal. Equilibrado y sostenible.</string>
    <string name="cat_diet_2_nombre">Día Vegano Hipocalórico</string>
    <string name="cat_diet_2_desc">Un día completo vegano con déficit calórico. Rico en fibra y micronutrientes.</string>
    <string name="cat_diet_3_nombre">Plan Volumen Limpio</string>
    <string name="cat_diet_3_desc">Superávit calórico moderado con alto aporte proteico para ganar masa muscular.</string>
    <string name="cat_diet_4_nombre">Día Volumen Sin Gluten</string>
    <string name="cat_diet_4_desc">Un día de volumen sin gluten. Alto en proteínas con fuentes libres de trigo.</string>
    <string name="cat_diet_5_nombre">Mantenimiento Sin Lácteos</string>
    <string name="cat_diet_5_desc">Plan semanal equilibrado sin productos lácteos. Alternativas vegetales incluidas.</string>
    <string name="cat_diet_6_nombre">Día Equilibrado</string>
    <string name="cat_diet_6_desc">Un día completo y equilibrado para mantener tu peso con todos los macros cubiertos.</string>
    <string name="cat_diet_7_nombre">Plan Definición Muscular</string>
    <string name="cat_diet_7_desc">Alto en proteínas y bajo en carbohidratos. Mantiene músculo mientras elimina grasa.</string>
    <string name="cat_diet_8_nombre">Día Definición Vegana</string>
    <string name="cat_diet_8_desc">Un día vegano optimizado para definir: alto en proteína vegetal y bajo en grasa.</string>
    <string name="cat_diet_9_nombre">Día Keto QuemaGrasa</string>
    <string name="cat_diet_9_desc">Plan cetogénico rico en grasas saludables. Ideal para forzar al cuerpo a usar grasa como energía.</string>
    <string name="cat_diet_10_nombre">Día Bulking Extremo</string>
    <string name="cat_diet_10_desc">Día de volumen potente para personas a las que les cuesta mucho subir de peso o muy activas.</string>

