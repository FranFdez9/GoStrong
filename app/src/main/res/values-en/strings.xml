    <!-- Catálogo Rutinas -->
    <string name="cat_rut_1_nombre">Beginner Fullbody</string>
    <string name="cat_rut_1_desc">Fullbody routine 3 days a week. Perfect to start at the gym.</string>
    <string name="cat_rut_2_nombre">Push Pull 4 Days</string>
    <string name="cat_rut_2_desc">Push/Pull routine for 4 days. Push (chest, shoulders, triceps) and pull (back, biceps).</string>
    <string name="cat_rut_3_nombre">Full Leg Session</string>
    <string name="cat_rut_3_desc">Intense leg session: quads, hamstrings, and calves.</string>
    <string name="cat_rut_4_nombre">Beginner Boxing 3 Days</string>
    <string name="cat_rut_4_desc">Introduction to boxing: technique, conditioning, and basic striking.</string>
    <string name="cat_rut_5_nombre">Intermediate MMA 4 Days</string>
    <string name="cat_rut_5_desc">Complete MMA routine: striking, grappling, strength, and conditioning.</string>
    <string name="cat_rut_6_nombre">Intense Boxing Session</string>
    <string name="cat_rut_6_desc">Complete boxing session of ~60 minutes. Technique + heavy bag + conditioning.</string>
    <string name="cat_rut_7_nombre">Beginner Running C25K</string>
    <string name="cat_rut_7_desc">3-day program to go from walking to running 5km. Based on the C25K method.</string>
    <string name="cat_rut_8_nombre">HIIT + Cardio 4 Days</string>
    <string name="cat_rut_8_desc">Combines explosive HIIT sessions with low-intensity cardio to burn fat.</string>
    <string name="cat_rut_9_nombre">HIIT Express 20 Minutes</string>
    <string name="cat_rut_9_desc">High-intensity session in just 20 minutes. No equipment, maximum caloric burn.</string>
    <string name="cat_rut_10_nombre">Strength Powerlifting 5x5</string>
    <string name="cat_rut_10_desc">The 5x5 method to gain pure strength by lifting maximum loads on basic movements.</string>
    <string name="cat_rut_11_nombre">Bodyweight Calisthenics Mastery</string>
    <string name="cat_rut_11_desc">Training using exclusively your body weight (calisthenics park or home).</string>

    <!-- Catálogo Dietas -->
    <string name="cat_diet_1_nombre">Caloric Deficit Plan</string>
    <string name="cat_diet_1_desc">Weekly plan with a moderate deficit of 400-500 kcal. Balanced and sustainable.</string>
    <string name="cat_diet_2_nombre">Hypocaloric Vegan Day</string>
    <string name="cat_diet_2_desc">A complete vegan day with caloric deficit. Rich in fiber and micronutrients.</string>
    <string name="cat_diet_3_nombre">Clean Bulking Plan</string>
    <string name="cat_diet_3_desc">Moderate caloric surplus with high protein intake to gain muscle mass.</string>
    <string name="cat_diet_4_nombre">Gluten-Free Bulking Day</string>
    <string name="cat_diet_4_desc">A bulking day without gluten. High in protein with wheat-free sources.</string>
    <string name="cat_diet_5_nombre">Dairy-Free Maintenance</string>
    <string name="cat_diet_5_desc">Balanced weekly plan without dairy products. Plant-based alternatives included.</string>
    <string name="cat_diet_6_nombre">Balanced Day</string>
    <string name="cat_diet_6_desc">A complete and balanced day to maintain your weight with all macros covered.</string>
    <string name="cat_diet_7_nombre">Muscle Definition Plan</string>
    <string name="cat_diet_7_desc">High in protein and low in carbohydrates. Maintains muscle while shredding fat.</string>
    <string name="cat_diet_8_nombre">Vegan Definition Day</string>
    <string name="cat_diet_8_desc">A vegan day optimized to shred: high in plant protein and low in fat.</string>
    <string name="cat_diet_9_nombre">Keto Fat Burner Day</string>
    <string name="cat_diet_9_desc">Ketogenic plan rich in healthy fats. Ideal to force the body to use fat for energy.</string>
    <string name="cat_diet_10_nombre">Extreme Bulking Day</string>
    <string name="cat_diet_10_desc">Heavy bulking day for people who find it very hard to gain weight or are very active.</string>

